<% content_for :title, "#{t('registrations.new.title')} - #{t('navbar.brand')}" %>

<div class="flex min-h-[70vh] items-center justify-center">
  <div class="w-full max-w-md p-8 bg-white rounded-2xl shadow-xl border border-gray-100"
       data-controller="registration"
       data-registration-failed-text-value="<%= t('registrations.new.registration_failed') %>"
       data-registration-network-error-text-value="<%= t('errors.network_error') %>">
    <div class="text-center mb-8">
      <div class="w-12 h-12 mx-auto rounded-2xl bg-indigo-600 flex items-center justify-center text-white font-bold text-xl shadow-md shadow-indigo-200 mb-4">
        M
      </div>
      <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight"><%= t("registrations.new.title") %></h1>
      <p class="mt-2 text-sm text-gray-500"><%= t("registrations.new.subtitle") %></p>
    </div>

    <div id="register-error-alert"
         data-registration-target="errorAlert"
         class="hidden mb-6 p-4 rounded-xl bg-red-50 border border-red-200 text-sm text-red-600">
      <ul id="register-error-list"
          data-registration-target="errorList"
          class="list-disc list-inside space-y-1"></ul>
    </div>

    <!-- Success Card UI -->
    <div id="register-success-alert"
         data-registration-target="successAlert"
         class="hidden mb-6 p-6 rounded-2xl bg-green-50 border border-green-200 text-center">
      <div class="w-12 h-12 mx-auto mb-3 rounded-full bg-green-100 flex items-center justify-center text-green-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <h3 class="text-lg font-bold text-green-900"><%= t("confirmations.show.success_msg") %></h3>
      <p id="register-success-msg"
         data-registration-target="successMsg"
         class="mt-2 text-sm text-green-700"></p>
      <div class="mt-6 flex flex-col gap-2">
        <a href="/login" class="w-full inline-flex justify-center items-center py-2.5 px-4 rounded-lg text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 shadow-sm transition-colors">
          <%= t("sessions.new.title") %>
        </a>
      </div>
    </div>

    <form id="register-form"
          data-registration-target="form"
          data-action="submit->registration#submit"
          class="space-y-5">
      <div>
        <label for="email" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t("registrations.new.email_label") %></label>
        <input type="email" id="email" name="email" required autocomplete="email"
               data-registration-target="emailInput"
               class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors text-sm shadow-2xs"
               placeholder="<%= t("registrations.new.email_placeholder") %>" />
      </div>

      <div>
        <label for="password" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t("registrations.new.password_label") %></label>
        <input type="password" id="password" name="password" required autocomplete="new-password"
               data-registration-target="passwordInput"
               class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors text-sm shadow-2xs"
               placeholder="••••••••" />
      </div>

      <div>
        <label for="password_confirmation" class="block text-sm font-semibold text-gray-700 mb-1.5"><%= t("registrations.new.password_confirmation_label") %></label>
        <input type="password" id="password_confirmation" name="password_confirmation" required autocomplete="new-password"
               data-registration-target="passwordConfirmationInput"
               class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors text-sm shadow-2xs"
               placeholder="••••••••" />
      </div>

      <div class="pt-2">
        <button type="submit" id="register-submit-btn"
                data-registration-target="submitBtn"
                class="w-full flex justify-center py-3 px-4 border border-transparent rounded-lg shadow-sm text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer transition-colors">
          <%= t("registrations.new.submit_btn") %>
        </button>
      </div>
    </form>

    <div id="register-footer"
         data-registration-target="footer"
         class="mt-6 text-center text-sm text-gray-600 border-t border-gray-100 pt-6">
      <%= t("registrations.new.has_account") %>
      <%= link_to t("registrations.new.sign_in_link"), login_path, class: "font-semibold text-indigo-600 hover:text-indigo-500 hover:underline" %>
    </div>
  </div>
</div>
