<%
  campaign = local_assigns[:campaign] || @campaign
  platform_campaigns = local_assigns[:platform_campaigns] || @platform_campaigns || campaign.platform_campaigns
%>

<div id="campaign_header_section" class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between pb-6 border-b border-gray-100 gap-4">
    <div>
      <div class="flex items-center space-x-3">
        <h1 class="text-2xl font-bold text-gray-900"><%= campaign.name %></h1>
        <% if campaign.status == "active" %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
            <span class="w-1.5 h-1.5 mr-1.5 bg-green-500 rounded-full"></span>
            <%= campaign.status.capitalize %>
          </span>
        <% elsif campaign.status == "published" %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800 border border-indigo-200">
            <span class="w-1.5 h-1.5 mr-1.5 bg-indigo-500 rounded-full"></span>
            <%= campaign.status.capitalize %>
          </span>
        <% else %>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
            <span class="w-1.5 h-1.5 mr-1.5 bg-gray-400 rounded-full"></span>
            <%= campaign.status.capitalize %>
          </span>
        <% end %>
      </div>
      <p class="text-sm text-gray-500 mt-1"><%= t("campaigns.show.details_subtitle") %></p>
    </div>

    <div class="flex items-center space-x-3">
      <%= link_to edit_campaign_path(campaign),
            class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors cursor-pointer" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
        <%= t("campaigns.show.edit_link") %>
      <% end %>
    </div>
  </div>

  <!-- 3 Stat Cards Grid: Budget, Objective, Synced Platforms Count -->
  <div class="mt-8 grid grid-cols-1 sm:grid-cols-3 gap-6">
    <!-- Card 1: Budget (VND) -->
    <div class="p-6 bg-gradient-to-br from-emerald-50/50 to-white rounded-xl border border-emerald-100 shadow-2xs flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold text-emerald-800 uppercase tracking-wider block">
          <%= t("campaigns.show.budget") %>
        </span>
        <p class="mt-2 text-2xl font-extrabold text-emerald-600 tracking-tight">
          <%= number_to_currency(campaign.budget, unit: "₫", precision: 0, delimiter: ".", format: "%n %u") %>
        </p>
        <span class="mt-1 text-xs text-emerald-700 block">
          <%= campaign.updated_at.strftime("%d/%m/%Y %H:%M") %>
        </span>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
    </div>

    <!-- Card 2: Objective -->
    <div class="p-6 bg-gradient-to-br from-indigo-50/50 to-white rounded-xl border border-indigo-100 shadow-2xs flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold text-indigo-800 uppercase tracking-wider block">
          <%= t("campaigns.show.objective") %>
        </span>
        <p class="mt-2 text-s font-bold text-gray-900 tracking-tight">
          <%= campaign.objective %>
        </p>
        <span class="mt-1 text-xs text-indigo-600 font-medium block">
          <%= t("campaigns.show.target_goal") %>
        </span>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
    </div>

    <!-- Card 3: Synced Platforms Count -->
    <div class="p-6 bg-gradient-to-br from-blue-50/50 to-white rounded-xl border border-blue-100 shadow-2xs flex items-center justify-between">
      <div>
        <span class="text-xs font-semibold text-blue-800 uppercase tracking-wider block">
          <%= t("campaigns.show.synced_platforms") %>
        </span>
        <p class="mt-2 text-2xl font-extrabold text-blue-700 tracking-tight">
          <%= platform_campaigns.count %>
        </p>
        <span class="mt-1 text-xs text-blue-600 font-medium block">
          <%= t("campaigns.show.connected_count", count: platform_campaigns.count) %>
        </span>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
      </div>
    </div>
  </div>
</div>
