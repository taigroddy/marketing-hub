<% content_for :title, "#{@campaign.name} - Campaign" %>

<div class="space-y-8">
  <%= turbo_stream_from "campaign_#{@campaign.id}" %>

  <!-- Section 1: Campaign Basic Info & Header -->
  <%= render "campaigns/campaign_header_section",
             campaign: @campaign,
             platform_campaigns: @platform_campaigns %>

  <!-- Section 2: Connected Platform Accounts for Publishing -->
  <%= render "campaigns/platform_accounts_section",
             campaign: @campaign,
             platform_accounts: @platform_accounts,
             platform_campaigns: @platform_campaigns,
             published_account_ids: @published_account_ids %>

  <!-- Section 3: Linked Platform Campaigns -->
  <%= render "campaigns/platform_campaigns_section",
             campaign: @campaign,
             platform_campaigns: @platform_campaigns %>
</div>
