<div class="max-w-4xl mx-auto py-8">
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
    <div class="flex items-center justify-between pb-6 border-b border-gray-100">
      <div>
        <div class="flex items-center space-x-3">
          <h1 class="text-2xl font-bold text-gray-900"><%= @campaign.name %></h1>
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800">
            <%= @campaign.status.capitalize %>
          </span>
        </div>
        <p class="text-sm text-gray-500 mt-1">Chi tiết chiến dịch quảng cáo và tình trạng đồng bộ nền tảng.</p>
      </div>
      <div class="flex items-center space-x-3">
        <%= link_to "Dashboard", dashboard_path,
              class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors" %>
        <%= link_to "Sửa budget", edit_campaign_path(@campaign),
              class: "px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors" %>
      </div>
    </div>

    <!-- Section 1: Campaign Basic Info -->
    <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-6 bg-gray-50 rounded-lg border border-gray-200">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Mục tiêu</h3>
        <p class="mt-2 text-lg font-bold text-gray-900"><%= @campaign.objective %></p>
      </div>

      <div class="p-6 bg-gray-50 rounded-lg border border-gray-200">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Ngân sách (Budget)</h3>
        <p class="mt-2 text-lg font-bold text-emerald-600">$<%= number_with_precision(@campaign.budget, precision: 2) %></p>
      </div>

      <div class="p-6 bg-gray-50 rounded-lg border border-gray-200">
        <h3 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Ngày tạo</h3>
        <p class="mt-2 text-sm font-medium text-gray-700"><%= @campaign.created_at.strftime("%d/%m/%Y %H:%M") %></p>
      </div>
    </div>
  </div>
</div>
