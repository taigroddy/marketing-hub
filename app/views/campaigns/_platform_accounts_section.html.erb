<%
  campaign = local_assigns[:campaign] || @campaign
  platform_accounts = local_assigns[:platform_accounts] || @platform_accounts || campaign.user.platform_accounts
  platform_campaigns = local_assigns[:platform_campaigns] || @platform_campaigns || campaign.platform_campaigns
  published_account_ids = local_assigns[:published_account_ids] || @published_account_ids || platform_campaigns.map(&:platform_account_id)
%>

<div id="platform_accounts_section" class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
  <div class="pb-4 border-b border-gray-100">
    <h2 class="text-lg font-bold text-gray-900">Nền tảng liên kết</h2>
    <p class="text-sm text-gray-500 mt-1">Chọn tài khoản quảng cáo đã kết nối để xuất bản và đồng bộ chiến dịch.</p>
  </div>

  <div id="publish-error-alert" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
    <p id="publish-error-msg" class="text-sm text-red-700"></p>
  </div>

  <% if platform_accounts.blank? %>
    <div class="mt-6 text-center py-8 bg-gray-50 rounded-lg border border-dashed border-gray-300">
      <p class="text-gray-500 text-sm">Bạn chưa kết nối tài khoản quảng cáo nào.</p>
      <%= link_to "Kết nối tài khoản tại Dashboard", dashboard_path, class: "mt-2 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>
  <% else %>
    <form id="publish-form" class="mt-6 space-y-4">
      <div class="divide-y divide-gray-100 border border-gray-200 rounded-lg overflow-hidden">
        <% platform_accounts.each do |account| %>
          <% already_published = published_account_ids.include?(account.id) %>
          <label class="flex items-center justify-between p-4 hover:bg-gray-50 transition-colors <%= 'bg-gray-50 opacity-75 cursor-not-allowed' if already_published %>">
            <div class="flex items-center space-x-3">
              <input type="checkbox"
                     name="platform_account_ids[]"
                     value="<%= account.id %>"
                     data-platform="<%= account.platform_name.downcase %>"
                     <%= "disabled" if already_published %>
                     class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 <%= 'cursor-not-allowed' if already_published %>">
              <div>
                <span class="text-sm font-medium text-gray-900"><%= account.name.presence || account.account_id %></span>
                <span class="ml-2 text-xs text-gray-500">(<%= account.platform_name %> - ID: <%= account.account_id %>)</span>
              </div>
            </div>

            <% if already_published %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-200 text-gray-700">
                Đã xuất bản
              </span>
            <% else %>
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                Sẵn sàng đồng bộ
              </span>
            <% end %>
          </label>
        <% end %>
      </div>

      <div class="pt-4 flex justify-end">
        <button type="submit" id="publish-submit-btn"
                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-lg shadow-sm transition-colors flex items-center space-x-2 cursor-pointer">
          <span>Sync to platform</span>
        </button>
      </div>
    </form>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const publishForm = document.getElementById('publish-form');
    if (!publishForm) return;

    const errorAlert = document.getElementById('publish-error-alert');
    const errorMsg = document.getElementById('publish-error-msg');
    const submitBtn = document.getElementById('publish-submit-btn');

    publishForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorAlert.classList.add('hidden');
      errorMsg.textContent = '';

      const checked = Array.from(publishForm.querySelectorAll('input[name="platform_account_ids[]"]:checked'));
      if (checked.length === 0) {
        errorAlert.classList.remove('hidden');
        errorMsg.textContent = 'Vui lòng chọn ít nhất một tài khoản quảng cáo để xuất bản.';
        return;
      }

      submitBtn.disabled = true;
      const accountIds = checked.map(el => parseInt(el.value, 10));
      const platform = checked[0].dataset.platform || 'facebook';

      try {
        const response = await fetch(`/api/v1/${platform}/campaigns/<%= campaign.id %>/publish`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ platform_account_ids: accountIds })
        });

        const data = await response.json();
        if (response.ok && data.success) {
          window.location.reload();
        } else {
          submitBtn.disabled = false;
          errorAlert.classList.remove('hidden');
          const errs = data.errors || 'Đồng bộ thất bại';
          errorMsg.textContent = typeof errs === 'object' ? JSON.stringify(errs) : String(errs);
        }
      } catch (err) {
        submitBtn.disabled = false;
        errorAlert.classList.remove('hidden');
        errorMsg.textContent = 'Lỗi kết nối máy chủ: ' + err.message;
      }
    });
  });
</script>
