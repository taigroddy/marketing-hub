<%
  campaign = local_assigns[:campaign] || @campaign
  platform_accounts = local_assigns[:platform_accounts] || @platform_accounts || campaign.user.platform_accounts
  platform_campaigns = local_assigns[:platform_campaigns] || @platform_campaigns || campaign.platform_campaigns
  published_account_ids = local_assigns[:published_account_ids] || @published_account_ids || platform_campaigns.map(&:platform_account_id)
%>

<div id="platform_accounts_section"
     class="bg-white rounded-xl shadow-sm border border-gray-100 p-8"
     data-controller="campaign-sync"
     data-campaign-sync-campaign-id-value="<%= campaign.id %>"
     data-campaign-sync-syncing-text-value="<%= t('campaigns.show.syncing') %>"
     data-campaign-sync-sync-to-platform-text-value="<%= t('campaigns.show.sync_to_platform') %>"
     data-campaign-sync-select-account-error-value="<%= t('campaigns.show.select_account_error') %>"
     data-campaign-sync-failed-text-value="<%= t('campaigns.show.sync_failed') %>"
     data-campaign-sync-server-error-text-value="<%= t('errors.network_error') %>">
  <div class="pb-4 border-b border-gray-100">
    <h2 class="text-lg font-bold text-gray-900"><%= t("campaigns.show.linked_platforms") %></h2>
    <p class="text-sm text-gray-500 mt-1"><%= t("campaigns.show.linked_platforms_desc") %></p>
  </div>

  <div id="publish-error-alert"
       data-campaign-sync-target="publishErrorAlert"
       class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
    <p id="publish-error-msg" data-campaign-sync-target="publishErrorMsg" class="text-sm text-red-700"></p>
  </div>

  <% if platform_accounts.blank? %>
    <div class="mt-6 text-center py-8 bg-gray-50 rounded-lg border border-dashed border-gray-300">
      <p class="text-gray-500 text-sm"><%= t("campaigns.show.no_linked_accounts") %></p>
      <%= link_to t("campaigns.show.connect_at_dashboard"), dashboard_path, class: "mt-2 inline-block text-sm font-medium text-indigo-600 hover:text-indigo-500" %>
    </div>
  <% else %>
    <form id="publish-form"
          data-action="submit->campaign-sync#publish"
          data-campaign-id="<%= campaign.id %>"
          class="mt-6 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% platform_accounts.each do |account| %>
          <% already_published = published_account_ids.include?(account.id) %>
          <label class="relative flex flex-col justify-between p-5 rounded-xl border-2 transition-all <%= already_published ? 'bg-gray-50 border-gray-200 opacity-60 cursor-not-allowed' : 'bg-white border-gray-200 hover:border-indigo-400 hover:shadow-sm cursor-pointer has-[:checked]:border-indigo-600 has-[:checked]:bg-indigo-50/20' %>">
            <div>
              <div class="flex items-start justify-between">
                <div>
                  <% if account.type.to_s.include?("Facebook") %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-blue-100 text-blue-800">
                      Facebook
                    </span>
                  <% else %>
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-emerald-100 text-emerald-800">
                      Google
                    </span>
                  <% end %>
                </div>

                <input type="checkbox"
                       name="platform_account_ids[]"
                       value="<%= account.id %>"
                       data-platform="<%= account.platform_name.downcase %>"
                       <%= "disabled" if already_published %>
                       class="h-5 w-5 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 <%= 'cursor-not-allowed' if already_published %>">
              </div>

              <div class="mt-3">
                <h4 class="text-sm font-bold text-gray-900 truncate" title="<%= account.name.presence || account.account_id %>">
                  <%= account.name.presence || account.account_id %>
                </h4>
                <p class="mt-1 text-xs text-gray-500 font-mono">
                  ID: <%= account.account_id %>
                </p>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between">
              <% if already_published %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-200 text-gray-700">
                  <%= t("campaigns.show.already_published") %>
                </span>
              <% else %>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                  <%= t("campaigns.show.ready_to_sync") %>
                </span>
              <% end %>
            </div>
          </label>
        <% end %>
      </div>

      <div class="pt-4 flex justify-end">
        <button type="submit"
                id="publish-submit-btn"
                data-campaign-sync-target="publishSubmitBtn"
                class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-sm rounded-lg shadow-sm transition-colors flex items-center space-x-2 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed">
          <span><%= t("campaigns.show.sync_to_platform") %></span>
        </button>
      </div>
    </form>
  <% end %>
</div>
