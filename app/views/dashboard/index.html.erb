<% content_for :title, "Dashboard" %>

<div class="space-y-8">
  <!-- Section 1: Platform Accounts Management -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
    <div class="flex items-center justify-between pb-4 border-b border-gray-100">
      <div>
        <h2 class="text-lg font-bold text-gray-900"><%= t("dashboard.platform_accounts_title") %></h2>
        <p class="text-sm text-gray-500 mt-0.5"><%= t("dashboard.platform_accounts_desc") %></p>
      </div>
      <div>
        <button type="button" onclick="document.getElementById('connect-modal').showModal()"
                class="inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors cursor-pointer">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <%= t("dashboard.connect_new") %>
        </button>
      </div>
    </div>

    <% if @platform_accounts.present? && @platform_accounts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
        <% @platform_accounts.each do |account| %>
          <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md hover:border-indigo-300 transition-all flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between pb-3 border-b border-gray-100">
                <% if account.type.to_s.include?("Facebook") %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-50 text-blue-700 border border-blue-200">
                    <svg class="w-3.5 h-3.5 mr-1.5 fill-current" viewBox="0 0 24 24">
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                    </svg>
                    Facebook
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                    Google
                  </span>
                <% end %>

                <% if account.connected? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
                    <span class="w-1.5 h-1.5 mr-1.5 bg-green-500 rounded-full"></span>
                    <%= t("dashboard.connected") %>
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                    <span class="w-1.5 h-1.5 mr-1.5 bg-gray-400 rounded-full"></span>
                    <%= account.status %>
                  </span>
                <% end %>
              </div>

              <div class="mt-4">
                <h4 class="text-base font-bold text-gray-900 truncate" title="<%= account.name.presence || account.account_id %>">
                  <%= account.name.presence || "—" %>
                </h4>
                <div class="mt-1 flex items-center text-xs text-gray-500 font-mono">
                  <span class="text-gray-400 mr-1.5">ID:</span>
                  <span><%= account.account_id %></span>
                </div>
              </div>
            </div>

            <div class="mt-5 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
              <span class="text-gray-400"><%= t("dashboard.connected_date_col") %>:</span>
              <span class="font-medium text-gray-700"><%= account.created_at.strftime("%d/%m/%Y %H:%M") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-10 px-4 border-2 border-dashed border-gray-200 rounded-2xl mt-6">
        <div class="w-12 h-12 mx-auto rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
          </svg>
        </div>
        <h3 class="mt-3 text-base font-bold text-gray-900"><%= t("dashboard.no_accounts") %></h3>
        <p class="mt-1 text-xs text-gray-500 max-w-sm mx-auto">
          <%= t("dashboard.no_accounts_desc") %>
        </p>
        <div class="mt-4">
          <button type="button" onclick="document.getElementById('connect-modal').showModal()"
                  class="inline-flex items-center px-4 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors cursor-pointer">
            <svg class="w-4 h-4 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <%= t("dashboard.link_first_account") %>
          </button>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Modal Liên kết mới -->
  <dialog id="connect-modal" class="fixed inset-0 m-auto w-full max-w-md p-0 rounded-2xl shadow-2xl border border-gray-100 bg-white backdrop:bg-gray-900/50">
    <div class="p-6"
         data-controller="oauth-connect"
         data-oauth-connect-network-error-text-value="<%= t('errors.network_error') %>"
         data-oauth-connect-connect-error-text-value="<%= t('dashboard.connect_error', error: '') %>">
      <div class="flex items-center justify-between pb-4 border-b border-gray-100">
        <h3 class="text-lg font-bold text-gray-900"><%= t("dashboard.modal_title") %></h3>
        <button type="button" onclick="document.getElementById('connect-modal').close()"
                class="text-gray-400 hover:text-gray-600 p-1 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <div class="mt-6 space-y-4">
        <!-- Facebook Option -->
        <button type="button" id="connect-facebook-btn"
                data-platform="facebook"
                data-action="click->oauth-connect#connect"
                class="w-full flex items-center justify-between p-4 border border-blue-200 bg-blue-50/50 hover:bg-blue-100/70 rounded-xl transition-all group cursor-pointer text-left">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold">
              f
            </div>
            <div>
              <div class="font-semibold text-gray-900">Facebook Ads</div>
              <div class="text-xs text-gray-500"><%= t("dashboard.facebook_desc") %></div>
            </div>
          </div>
          <span class="text-blue-600 group-hover:translate-x-1 transition-transform font-medium text-sm">
            <%= t("dashboard.connect_btn") %> &rarr;
          </span>
        </button>

        <!-- Google Option (Disabled with Tooltip/Badge) -->
        <div class="flex items-center justify-between p-4 border border-gray-200 bg-gray-50 rounded-xl opacity-60 cursor-not-allowed relative"
             title="<%= t("dashboard.coming_soon") %>">
          <div class="flex items-center space-x-3">
            <div class="w-10 h-10 rounded-lg bg-red-500 flex items-center justify-center text-white font-bold">
              G
            </div>
            <div>
              <div class="flex items-center space-x-2">
                <span class="font-semibold text-gray-900">Google Ads</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-800">
                  <%= t("dashboard.coming_soon") %>
                </span>
              </div>
              <div class="text-xs text-gray-500"><%= t("dashboard.google_desc") %></div>
            </div>
          </div>
          <button type="button" disabled class="text-gray-400 font-medium text-sm cursor-not-allowed" title="<%= t("dashboard.coming_soon") %>">
            <%= t("dashboard.coming_soon") %>
          </button>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-gray-100 flex justify-end">
        <button type="button" onclick="document.getElementById('connect-modal').close()"
                class="px-4 py-2 text-sm font-medium text-gray-700 bg-gray-100 hover:bg-gray-200 rounded-lg transition-colors cursor-pointer">
          <%= t("dashboard.close") %>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Section 2: Campaigns Management -->
  <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-8">
    <div class="flex items-center justify-between pb-6 border-b border-gray-100">
      <div>
        <h2 class="text-xl font-bold text-gray-900"><%= t("dashboard.campaigns_title") %></h2>
        <p class="text-sm text-gray-500 mt-1"><%= t("dashboard.campaigns_desc") %></p>
      </div>
      <div>
        <%= link_to new_campaign_path,
              class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors cursor-pointer" do %>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
          </svg>
          <%= t("dashboard.create_new") %>
        <% end %>
      </div>
    </div>

    <div class="mt-6">
      <% if @campaigns.present? && @campaigns.any? %>
        <div class="overflow-hidden border border-gray-200 rounded-xl">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50/80">
              <tr class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                <th scope="col" class="py-3.5 px-5"><%= t("dashboard.campaign_name_col") %></th>
                <th scope="col" class="py-3.5 px-5"><%= t("dashboard.objective_col") %></th>
                <th scope="col" class="py-3.5 px-5"><%= t("dashboard.budget_col") %></th>
                <th scope="col" class="py-3.5 px-5"><%= t("dashboard.status_col") %></th>
                <th scope="col" class="py-3.5 px-5 text-right"><%= t("dashboard.actions_col") %></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% @campaigns.each do |campaign| %>
                <tr class="hover:bg-indigo-50/30 transition-colors group">
                  <td class="py-4 px-5 text-sm font-bold text-gray-900 group-hover:text-indigo-600 transition-colors">
                    <%= campaign.name %>
                  </td>
                  <td class="py-4 px-5 text-sm">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200/60">
                      <%= campaign.objective %>
                    </span>
                  </td>
                  <td class="py-4 px-5 text-sm font-extrabold text-emerald-600">
                    <%= number_to_currency(campaign.budget, unit: "₫", precision: 0, delimiter: ".", format: "%n %u") %>
                  </td>
                  <td class="py-4 px-5 text-sm">
                    <% if campaign.status == "active" %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-green-100 text-green-800 border border-green-200">
                        <span class="w-1.5 h-1.5 mr-1.5 bg-green-500 rounded-full"></span>
                        <%= campaign.status.capitalize %>
                      </span>
                    <% elsif campaign.status == "published" %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-100 text-indigo-800 border border-indigo-200">
                        <span class="w-1.5 h-1.5 mr-1.5 bg-indigo-500 rounded-full"></span>
                        <%= campaign.status.capitalize %>
                      </span>
                    <% else %>
                      <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 border border-gray-200">
                        <span class="w-1.5 h-1.5 mr-1.5 bg-gray-400 rounded-full"></span>
                        <%= campaign.status.capitalize %>
                      </span>
                    <% end %>
                  </td>
                  <td class="py-4 px-5 text-sm text-right">
                    <%= link_to campaign_path(campaign),
                          class: "inline-flex items-center text-sm font-semibold text-indigo-600 hover:text-indigo-900 transition-colors cursor-pointer group-hover:translate-x-0.5" do %>
                      <span><%= t("dashboard.view_detail") %></span>
                      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                      </svg>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-center py-12 px-4 border-2 border-dashed border-gray-200 rounded-2xl">
          <div class="w-12 h-12 mx-auto rounded-xl bg-indigo-50 text-indigo-500 flex items-center justify-center">
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="mt-4 text-base font-bold text-gray-900"><%= t("dashboard.no_campaigns") %></h3>
          <p class="mt-1 text-sm text-gray-500"><%= t("dashboard.no_campaigns_desc") %></p>
          <div class="mt-6">
            <%= link_to new_campaign_path,
                  class: "inline-flex items-center px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-sm transition-colors cursor-pointer" do %>
              <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
              </svg>
              <%= t("dashboard.create_first_campaign") %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
