<% content_for :title, "#{t('confirmations.show.title')} - #{t('navbar.brand')}" %>

<div class="flex min-h-[70vh] items-center justify-center">
  <div class="w-full max-w-md p-8 bg-white rounded-2xl shadow-xl border border-gray-100 text-center"
       data-controller="confirmation"
       data-confirmation-token-value="<%= j(@token.to_s) %>"
       data-confirmation-network-error-text-value="<%= t('errors.network_error') %>"
       data-confirmation-error-msg-text-value="<%= t('confirmations.show.error_msg') %>"
       data-confirmation-dashboard-url-value="<%= dashboard_path %>">
    <!-- Brand Icon -->
    <div class="w-12 h-12 mx-auto rounded-2xl bg-indigo-600 flex items-center justify-center text-white font-bold text-xl shadow-md shadow-indigo-200 mb-6">
      M
    </div>

    <!-- State 1: Loading / In-Progress -->
    <div id="confirmation-loading"
         data-confirmation-target="loading"
         class="space-y-4">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-indigo-50 text-indigo-600">
        <svg class="w-6 h-6 animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </div>
      <h2 class="text-xl font-bold text-gray-900"><%= t("confirmations.show.verifying") %></h2>
    </div>

    <!-- State 2: Success -->
    <div id="confirmation-success"
         data-confirmation-target="success"
         class="hidden space-y-4">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-green-50 text-green-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
      </div>
      <h2 class="text-xl font-bold text-gray-900"><%= t("confirmations.show.success_msg") %></h2>
    </div>

    <!-- State 3: Error -->
    <div id="confirmation-error"
         data-confirmation-target="error"
         class="hidden space-y-4">
      <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-red-50 text-red-600">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
      <h2 class="text-xl font-bold text-gray-900"><%= t("confirmations.show.title") %></h2>
      <p id="confirmation-error-msg"
         data-confirmation-target="errorMsg"
         class="text-sm text-red-600"><%= t("confirmations.show.error_msg") %></p>
      <div class="pt-4">
        <%= link_to t("confirmations.show.login_btn"), login_path,
              class: "inline-flex items-center justify-center px-5 py-2.5 rounded-lg text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition-colors shadow-sm" %>
      </div>
    </div>
  </div>
</div>
