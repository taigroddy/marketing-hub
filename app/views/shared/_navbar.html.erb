<header class="bg-white border-b border-gray-100 shadow-sm sticky top-0 z-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Left: Brand / Home Link -->
      <div class="flex items-center space-x-3">
        <%= link_to dashboard_path, class: "flex items-center space-x-2 text-indigo-600 hover:text-indigo-700 transition-colors" do %>
          <div class="w-8 h-8 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-bold text-sm shadow-sm">
            M
          </div>
          <span class="font-bold text-lg text-gray-900 tracking-tight">Marketing Hub</span>
        <% end %>
      </div>

      <!-- Right: Language Toggle, User Email, and Sign Out -->
      <div class="flex items-center space-x-4">
        <!-- Language Switcher (EN / VI) -->
        <div class="inline-flex rounded-lg p-0.5 bg-gray-100 border border-gray-200 text-xs font-semibold">
          <button type="button"
                  onclick="setLanguage('en')"
                  class="px-2.5 py-1 rounded-md transition-colors cursor-pointer <%= I18n.locale.to_s == 'en' ? 'bg-white text-indigo-600 shadow-xs' : 'text-gray-500 hover:text-gray-900' %>">
            EN
          </button>
          <button type="button"
                  onclick="setLanguage('vi')"
                  class="px-2.5 py-1 rounded-md transition-colors cursor-pointer <%= I18n.locale.to_s == 'vi' ? 'bg-white text-indigo-600 shadow-xs' : 'text-gray-500 hover:text-gray-900' %>">
            VI
          </button>
        </div>

        <% if current_user.present? %>
          <!-- User Email -->
          <div class="hidden sm:flex items-center space-x-1.5 text-xs text-gray-600 bg-gray-50 px-3 py-1.5 rounded-lg border border-gray-200">
            <svg class="w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            <span class="font-medium text-gray-800"><%= current_user.email %></span>
          </div>

          <!-- Sign Out Button -->
          <div>
            <button type="button"
                    onclick="handleLogout()"
                    class="px-3 py-1.5 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition-colors cursor-pointer border border-red-100">
              <%= t("navbar.sign_out") %>
            </button>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</header>

<script>
  function setLanguage(lang) {
    document.cookie = "locale=" + lang + "; path=/; max-age=31536000; SameSite=Lax";
    window.location.reload();
  }

  function clearCookie(name) {
    const isHttps = window.location.protocol === 'https:';
    const secureFlag = isHttps ? '; Secure' : '';
    document.cookie = `${name}=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax${secureFlag}`;
    document.cookie = `${name}=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT; SameSite=Lax`;
    document.cookie = `${name}=; path=/; max-age=0; expires=Thu, 01 Jan 1970 00:00:00 GMT`;
  }

  async function handleLogout() {
    let token = document.querySelector('meta[name="auth-token"]')?.content;
    if (!token) {
      const jwtMatch = document.cookie.match(/(?:^|;\s*)jwt_token=([^;]+)/);
      token = jwtMatch ? decodeURIComponent(jwtMatch[1]) : null;
    }

    const cookieMatches = document.cookie.match(/(?:^|;\s*)refresh_token=([^;]+)/);
    const refreshToken = cookieMatches ? decodeURIComponent(cookieMatches[1]) : null;

    try {
      const headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json'
      };
      if (token) headers['Authorization'] = `Bearer ${token}`;

      const payload = {};
      if (refreshToken) payload.refresh_token = refreshToken;

      await fetch('/api/v1/auth/logout', {
        method: 'POST',
        headers: headers,
        body: JSON.stringify(payload)
      });
    } catch (_err) {
      // Ignore network errors on logout
    } finally {
      clearCookie('jwt_token');
      clearCookie('refresh_token');
      window.location.href = '<%= login_path(logout: 1) %>';
    }
  }
</script>
